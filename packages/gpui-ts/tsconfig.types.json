{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": "../../ui/src",
    "outDir": "types"
  },
  "include": ["../../ui/src/**/*.ts", "../../ui/src/**/*.tsx"]
}
