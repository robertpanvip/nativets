# Generated by `node scripts/build-package.mjs` from the repo sources — never edit
# these by hand, and no need to track them in git.
#
# They ARE published to npm: `package.json`'s `files` whitelist overrides
# .gitignore, so `npm pack` picks them up from a checkout that has just run the
# build script.
