{
  "name": "nativets",
  "version": "0.1.0",
  "description": "NativeTS — a compiled-TypeScript toolchain with a Go-like dev experience: nativets dev for the edit-rebuild-restart loop, nativets build for a self-contained native executable. No Rust/MSVC/Electron.",
  "keywords": [
    "gpui",
    "typescript",
    "tsx",
    "desktop",
    "native",
    "quickjs",
    "gui",
    "rust"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "nativets": "./bin/gpui-ts.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./runtime/index.js",
      "default": "./runtime/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "files": [
    "bin/",
    "lib/",
    "runtime/",
    "types/",
    "vendor/",
    "README.md"
  ],
  "dependencies": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "build:runtime": "node ../../scripts/build-package.mjs"
  }
}
