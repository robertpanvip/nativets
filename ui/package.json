{
  "name": "gpui-perryts-ui",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript frontend for the gpui-perryts host (Perry-native or node-dev mode)",
  "scripts": {
    "build": "node build.mjs",
    "build:perry": "node build-perry.mjs",
    "build:qjs": "node build-qjs.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node build.mjs && node dist/main.js"
  },
  "devDependencies": {
    "@perryts/perry": "^0.5.1520",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
